{
  "name": "habit-tracker",
  "version": "1.0.0",
  "description": "Capstone starter - habit tracker with streaks",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "lint": "eslint .",
    "test": "c8 --include=src/streaks.js --check-coverage --lines 70 --branches 70 --functions 70 node --test tests/unit/streaks.test.js",
    "test:ci": "node -e \"require('fs').mkdirSync('test-results', { recursive: true })\" && node --test --test-reporter=junit --test-reporter-destination=test-results/results.xml tests/unit/streaks.test.js",
    "test:integration": "node --test tests/integration/habits.test.js"
  },
  "dependencies": {
    "express": "4.19.2",
    "pg": "8.12.0",
    "redis": "4.6.14"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
