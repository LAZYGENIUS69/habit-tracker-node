# Database credentials. Compose uses these for the db container and builds the app's DATABASE_URL from them.
POSTGRES_USER=habits
POSTGRES_PASSWORD=habits
POSTGRES_DB=habits

# Compose ignores DATABASE_URL and derives it from the POSTGRES_* values above.
# Reference only: the host name db exists inside the Compose network and nowhere else.
DATABASE_URL=postgresql://habits:habits@db:5432/habits
REDIS_URL=redis://cache:6379
PORT=8080
